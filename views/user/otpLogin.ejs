<%- include('../layout/header.ejs') -%>

<div class="wrapper">
  <div class="" style="margin-left: 5rem">
    <img src="assets2\img\apple-icon.png" alt="" />
  </div>

  <div class="text-center mb-4">
    <h3>OTP Login</h3>
  </div>

  <div class="row justify-content-center">
    <div class="col-md-6 col-lg-4">
      <% if (messages && messages.blocked) { %>
        <div class="alert alert-danger" role="alert"><%= messages.blocked %></div>
      <% } %>
      <% if (messages && messages.error) { %>
        <div class="alert alert-danger" role="alert"><%= messages.error %></div>
      <% } %>
    </div>
  </div>

  <form id="myform" action="/send-otp" method="post">
    <div class="input-box mb-3">
      <input
        class="form-control"
        type="email"
        name="email"
        placeholder="Enter your email"
        id="input"
        required
      />
    </div>
    <div class="input-box button d-grid">
      <input class="btn btn-outline-dark" type="Submit" value="Send OTP" />
    </div>
  </form>
</div>
<%- include('../layout/footer.ejs') -%>
